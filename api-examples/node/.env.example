APP_ENV=development
HOST=0.0.0.0
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=npora
DB_PASSWORD=replace-with-a-local-password
DB_NAME=npora_admin
DB_CONNECTION_LIMIT=10

# Generate independently for each environment. Use 32 random bytes encoded as hex.
AUTH_PEPPER=replace-with-64-hex-characters
TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters
SESSION_DEFAULT_TTL_MS=28800000
SESSION_REMEMBER_TTL_MS=2592000000
AUTH_TOTP_ENABLED=false
CORS_ORIGINS=http://localhost:8000,http://localhost:9000
