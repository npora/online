{
  "name": "npora-www",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "routes": [
    { "pattern": "www.npora.live/*", "zone_name": "npora.live" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
