{
  "name": "npora-online-react",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "react.npora.live", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "services": [
    { "binding": "API", "service": "npora-online-react-api" }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
