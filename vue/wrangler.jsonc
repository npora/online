{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "admin-demo",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "admin.npora.live", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "services": [
    { "binding": "API", "service": "npora-admin-api-test" }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
